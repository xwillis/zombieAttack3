# Copy to .env and fill in. Never commit .env.
# ---- Site ----
SITE_URL=http://localhost:8080
SITE_TITLE=Texas Mountaineers
HTTP_PORT=8080
FORCE_SSL_ADMIN=false

# ---- Admin user (created on first init) ----
ADMIN_USER=tmadmin
ADMIN_EMAIL=admin@texasmountaineers.org
ADMIN_PASSWORD=change-me-now

# ---- Database ----
DB_NAME=tm_portal
DB_USER=tm_portal
DB_PASSWORD=change-me-db
DB_ROOT_PASSWORD=change-me-root

# ---- Mail (SMTP) ----
MAIL_FROM=noreply@texasmountaineers.org
MAIL_FROM_NAME=Texas Mountaineers
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=tls

# ---- Discord (optional, for member invites on activation) ----
DISCORD_WEBHOOK_URL=

# ---- Payment gateways (PMPro reads these in admin; left blank by default) ----
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
PAYPAL_EMAIL=

# ---- Backups ----
BACKUP_RETENTION_DAYS=14
